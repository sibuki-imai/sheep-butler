{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sheep-butler",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",

  "previews": {},

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
